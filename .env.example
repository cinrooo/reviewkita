# ReviewKita Environment Configuration
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai

# Port server (di cPanel biasanya sudah diatur otomatis, biarkan 3000)
PORT=3000

# URL domain publik Anda (WAJIB diisi sebelum generate kartu QR)
BASE_URL=https://reviewkita.my.id

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Kredensial Admin Panel (/admin)
ADMIN_USER=ganti_username_admin
ADMIN_PASS=ganti_password_yang_kuat

# Secret untuk enkripsi session (isi dengan string acak panjang)
SESSION_SECRET=ganti_dengan_string_acak_yang_sangat_panjang_dan_unik
